---
import { env } from "cloudflare:workers";
import {
  getHopperCoffee,
  getSettings,
  getUpcomingSpecialDays,
  getWeekHours,
} from "@falco/db";
import { addDays, getOpenStatus, toArgentina } from "@falco/domain";
import Base from "../layouts/Base.astro";
import Calendario from "../components/Calendario.astro";
import Dialogo from "../components/Dialogo.astro";
import { dayMoment } from "../components/fecha";
import Horarios from "../components/Horarios.astro";
import {
  groupWeek,
  instagramDmUrl,
  upcomingSpecials,
} from "../components/horarios";
import Mapa from "../components/Mapa.astro";
import Nav from "../components/Nav.astro";
import { OpenNow } from "../islands/OpenNow";

const now = new Date();
const nowAR = toArgentina(now);
const [week, specials, settings, coffee] = await Promise.all([
  getWeekHours(env.DB),
  getUpcomingSpecialDays(env.DB, nowAR.date, 30),
  getSettings(env.DB),
  getHopperCoffee(env.DB),
]);
const status = getOpenStatus(now, week, specials);

const [, monthText, dayText] = nowAR.date.split("-");
const [, , previousDayText] = addDays(nowAR.date, -1).split("-");

const ADDRESS = "Iriondo 2153, Santo Tomé, Santa Fe";
// Con el nombre del local, Google Maps cae en la ficha de Falco Café y no en
// un punto suelto de la calle.
const MAPS = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
  `Falco Café, ${ADDRESS}`,
)}`;
const dm = instagramDmUrl(settings.instagram_url);
---

<Base
  title="Dónde estamos · Falco"
  description={`Falco queda en ${ADDRESS}, a media cuadra de la Av. 7 de Marzo. Mirá los horarios y cómo llegar.`}
>
  <Nav slot="nav" />

  <div class="donde grainy">
    <div class="donde__izq">
      <header class="donde__encabezado">
        <span class="chip chip--fill chip--shadow">Dónde estamos</span>
        <h1 class="donde__titulo">Iriondo 2153</h1>
        <div class="hud">
          <Calendario
            weekday={nowAR.weekday}
            day={Number(dayText)}
            month={Number(monthText)}
            previousDay={Number(previousDayText)}
            moment={dayMoment(nowAR.minutes)}
          />
          <OpenNow week={week} specials={specials} initial={status} client:idle />
        </div>
      </header>

      <div class="donde__horarios">
        <Horarios
          rows={groupWeek(week, nowAR.weekday)}
          specials={upcomingSpecials(specials, nowAR.date)}
          roaster={coffee?.roaster}
        />
      </div>

      <nav class="donde__acciones" aria-label="Cómo contactarnos">
        <a class="boton" href={MAPS} target="_blank" rel="noopener">Cómo llegar</a>
        <a class="boton boton--tostado" href="/carta" target="_blank" rel="noopener">
          Ver la carta ↗
        </a>
        {
          dm && (
            <a class="boton boton--linea donde__dm" href={dm} target="_blank" rel="noopener">
              Escribir por DM
            </a>
          )
        }
      </nav>
      <p class="direccion donde__nota">“Ver la carta” abre la carta en Google Drive</p>
    </div>

    <div class="donde__der">
      <div class="donde__mapa">
        <Mapa href={MAPS} />
      </div>
      <div class="donde__dialogo">
        <Dialogo etiqueta="Barista">
          <p>
            Si nunca probaste café de especialidad, este es un buen lugar para
            empezar. Pedí un filtrado y preguntá lo que quieras.
          </p>
        </Dialogo>
      </div>
    </div>
  </div>
</Base>

<style>
  /*
   * Escritorio: dos columnas, como en la lámina (600px y el resto, 64 de
   * aire). En el celular las columnas desaparecen (display: contents) y los
   * bloques se reordenan: el mapa sube justo abajo del estado, antes de los
   * horarios, que es lo que se busca al entrar con el teléfono en la mano.
   */
  .donde {
    display: grid;
    grid-template-columns: minmax(0, 600px) minmax(0, 1fr);
    gap: 64px;
    padding: 60px var(--space-xxl);
    /* Las sombras corridas de los carteles y el grano asoman unos píxeles
       por el borde: sin esto la página se desplazaba de costado en el
       celular. clip, y no hidden, para no crear un contenedor de scroll. */
    overflow-x: clip;
  }

  .donde__izq,
  .donde__der {
    display: grid;
    align-content: start;
  }

  .donde__izq {
    gap: 28px;
  }

  .donde__der {
    gap: var(--space-xl);
  }

  .donde__encabezado {
    display: grid;
    gap: 28px;
    justify-items: start;
  }

  .donde__titulo {
    font-weight: 500;
    font-size: clamp(46px, 5.4vw, 72px);
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .donde__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .donde__acciones .boton {
    min-height: 50px;
  }

  .donde__nota {
    font-size: 9px;
  }

  .donde__dialogo {
    max-width: 560px;
  }

  @media (max-width: 899px) {
    .donde {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
      padding: 28px 22px 40px;
    }

    .donde__izq,
    .donde__der {
      display: contents;
    }

    .donde__encabezado {
      order: 1;
      gap: 22px;
    }
    .donde__mapa {
      order: 2;
    }
    .donde__horarios {
      order: 3;
    }
    .donde__acciones {
      order: 4;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .donde__nota {
      order: 5;
    }
    .donde__dialogo {
      order: 6;
      padding-top: var(--space-sm);
    }

    .donde__acciones .boton {
      padding-inline: 10px;
      font-size: 9px;
    }

    .donde__dm {
      grid-column: 1 / -1;
    }
  }
</style>
