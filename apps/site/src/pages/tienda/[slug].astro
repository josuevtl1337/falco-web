---
import { env } from "cloudflare:workers";
import { getProductBySlug, listCoffeesByIds } from "@falco/db";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import DetalleProducto from "../../components/DetalleProducto.astro";

const { slug } = Astro.params;
const product = slug ? await getProductBySlug(env.DB, slug) : undefined;

if (!product) {
  return Astro.redirect("/404", 302);
}

const [coffee] = product.coffeeId
  ? await listCoffeesByIds(env.DB, [product.coffeeId])
  : [];

const shelfLabel = product.shelf === "coffee" ? "Café" : "Kits y accesorios";
---

<!--
  La misma vista que el panel de la tienda, como página propia.

  Existe para que el enlace se pueda compartir, abrir en otra pestaña y leer
  sin JavaScript: en la tienda la ficha abre este mismo detalle encima, pero el
  enlace de abajo siempre es real.
-->
<Base
  title={`${product.name} · Falco`}
  description={product.description ?? product.detail}
>
  <Nav slot="nav" />

  <div class="pagina detalle-pagina">
    <a class="detalle-pagina__volver" href="/#tienda">‹ Volver a la tienda</a>

    <DetalleProducto
      product={product}
      coffee={coffee}
      shelfLabel={shelfLabel}
      titleTag="h1"
    />
  </div>
</Base>

<script>
  import { conectarPedido } from "../../scripts/pedido";

  conectarPedido();
</script>

<style>
  .detalle-pagina {
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
    max-width: 540px;
  }

  .detalle-pagina__volver {
    font-family: var(--font-mono);
    font-size: var(--text-nano);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brasa);
    text-decoration: none;
  }
</style>
