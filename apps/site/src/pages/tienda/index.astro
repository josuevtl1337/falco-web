---
import { env } from "cloudflare:workers";
import { listShelf } from "@falco/db";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Ficha from "../../components/Ficha.astro";

const [coffee, kits] = await Promise.all([
  listShelf(env.DB, "coffee"),
  listShelf(env.DB, "kits"),
]);
const shelves = [
  { title: "Café", products: coffee },
  { title: "Kits y accesorios", products: kits },
];
---

<Base
  title="La tienda · Falco"
  description="Café de especialidad, kits y accesorios para llevar de Falco, en Santo Tomé."
>
  <Nav slot="nav" />
  <div class="pagina">
    <h1>La tienda</h1>
    {
      shelves.map((shelf) => (
      <section aria-labelledby={`estante-${shelf.title}`}>
        <h2 id={`estante-${shelf.title}`}>{shelf.title}</h2>
        {shelf.products.length === 0 ? (
          <p>
            Por ahora no hay nada en este estante. Escribinos y te contamos
            qué tenemos.
          </p>
        ) : (
          <ul class="estante">
            {shelf.products.map((product) => (
              <li>
                <Ficha product={product} />
              </li>
            ))}
          </ul>
        )}
      </section>
    ))
  }
  </div>
</Base>

<style>
  .estante {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-md);
  }
</style>
