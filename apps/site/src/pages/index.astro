---
import { env } from "cloudflare:workers";
import { getHopperCoffee } from "@falco/db";
import Base from "../layouts/Base.astro";

const coffee = await getHopperCoffee(env.DB);
---

<Base
  title="Falco · café de santoto"
  description="Café de especialidad en Santo Tomé. Mirá qué hay en la tolva y llevate un cuarto."
>
  <h1>Falco</h1>
  {coffee && <p>En tolva: {coffee.name} · {coffee.country}</p>}
</Base>
