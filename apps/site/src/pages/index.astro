---
import { env } from "cloudflare:workers";
import {
  getHopperCoffee,
  getUpcomingSpecialDays,
  getWeekHours,
  listShelf,
} from "@falco/db";
import { addDays, getOpenStatus, toArgentina } from "@falco/domain";
import Base from "../layouts/Base.astro";
import Calendario from "../components/Calendario.astro";
import Dialogo from "../components/Dialogo.astro";
import { dayMoment } from "../components/fecha";
import Nav from "../components/Nav.astro";
import Origen from "../components/Origen.astro";
import { placeLabel } from "../components/origen";
import Pentagono from "../components/Pentagono.astro";
import Tienda from "../components/Tienda.astro";
import { OpenNow } from "../islands/OpenNow";

const now = new Date();
const week = await getWeekHours(env.DB);
const nowAR = toArgentina(now);
const specials = await getUpcomingSpecialDays(env.DB, nowAR.date, 30);
const status = getOpenStatus(now, week, specials);
const coffee = await getHopperCoffee(env.DB);

// Los estantes son lo que sigue abajo de la primera pantalla: la home termina
// donde termina la ventana y scrollear ya es entrar en la tienda.
const [coffeeShelf, kitsShelf] = await Promise.all([
  listShelf(env.DB, "coffee"),
  listShelf(env.DB, "kits"),
]);
const shelves = [
  { title: "Café", products: coffeeShelf },
  { title: "Kits y accesorios", products: kitsShelf },
];

// nowAR.date siempre es "AAAA-MM-DD": partirlo evita una segunda pasada por
// Intl solo para el número de día y de mes.
const [, monthText, dayText] = nowAR.date.split("-");

// El día anterior es un detalle de la lámina (el número que sale volando
// cuando entra el de hoy), no un dato de la base: se calcula igual que hoy.
const [, , previousDayText] = addDays(nowAR.date, -1).split("-");

const tickerText =
  [
    coffee && `En tolva ${coffee.country}`,
    coffee && `Tostadero ${coffee.roaster}`,
    "Iriondo 2153 · Santo Tomé",
  ]
    .filter((item): item is string => Boolean(item))
    .join("\u2003◆\u2003") + "\u2003◆\u2003";

// La cinta son dos grupos idénticos y el bucle desplaza exactamente la mitad,
// así que al terminar, el grupo 2 está donde arrancó el grupo 1 y la lectura
// no se corta. Para que nunca aparezca la franja marrón vacía, un grupo tiene
// que ser más ancho que la pantalla: a 12px de Martian Mono con 0,16em de
// tracking cada carácter ocupa unos 8px, y repetimos hasta pasar los 4000px.
// La cuenta va a la baja a propósito: quedarse corto deja hueco, pasarse no
// se nota.
const TICKER_CHAR_WIDTH = 8;
const TICKER_MIN_GROUP_WIDTH = 4000;
// Una vuelta de UNA copia del texto tarda esto: la duración total se multiplica
// por las repeticiones para que la cinta ande siempre a la misma velocidad,
// sin importar cuántas copias haya hecho falta apilar.
const TICKER_SECONDS_PER_COPY = 38;

const tickerCopies = Math.max(
  1,
  Math.ceil(TICKER_MIN_GROUP_WIDTH / (tickerText.length * TICKER_CHAR_WIDTH)),
);
const tickerGroup = tickerText.repeat(tickerCopies);
const tickerDuration = `${tickerCopies * TICKER_SECONDS_PER_COPY}s`;
---

