      ></ellipse>
    </svg>

    <header class="hud zona-hud">
      <Calendario
        weekday={nowAR.weekday}
        day={Number(dayText)}
        month={Number(monthText)}
        previousDay={Number(previousDayText)}
        moment={dayMoment(nowAR.minutes)}
      />
      <OpenNow week={week} specials={specials} initial={status} client:idle />
      <p class="direccion">Iriondo 2153 · Santo Tomé, Santa&nbsp;Fe</p>
    </header>

    <section class="presentacion zona-texto">
      <h1 class="hero"><span>café de</span><span>santoto</span></h1>
      <!-- Solo en tablet y escritorio: en el celular no se muestra. -->
      <p class="bajada">
        Somos una cafetería de especialidad en una esquina de Santo Tomé.
        Tostamos con <b>Puerto Blest</b> y servimos café que se puede entender
        sin saber nada de café.
      </p>
      <!--
        El envoltorio existe para poder ordenarlo: en el celular la cita va
        última (lámina), y los estilos con scope de esta página no alcanzan la
        raíz de <Dialogo>, que lleva el scope de su propio componente.
      -->
      <div class="zona-cita">
        <Dialogo>
          <p>
            Nuestra misión siempre fue la misma: traer el mundo del café a
            Santo Tomé.
          </p>
        </Dialogo>
      </div>
    </section>

    {
      coffee && (
        <section class="panel tolva zona-panel" aria-label="En tolva ahora">
          <span class="chip chip--fill chip--shadow">En tolva ahora</span>

          <div class="tolva__grid">
            <div class="tolva__info">
              <Origen coffee={coffee} />

              <div class="tolva__sabor">
                <span class="chip chip--fill">A qué sabe</span>
                <Pentagono profile={coffee.profile} />
              </div>

              <div class="tolva__tostadero">
                <span class="chip chip--fill">Tostadero</span>
                <p>{coffee.roaster}</p>
              </div>
            </div>

            <figure class="tolva__molino" aria-hidden="true">
              <img src="/molino-e65s.svg" alt="" width="240" height="560" />
              <figcaption>Mahlkönig E65S</figcaption>
            </figure>
          </div>

          <div class="tolva__pie">
            <span>Cambia cada vez que cambiamos el grano</span>
            <a href="#tienda">Llevate un cuarto →</a>
          </div>
        </section>
      )
    }

    {
      /*
       * La misma tolva, para el celular. El panel entero mide 699px: en una
       * pantalla de 844 se come todo y empuja el resto fuera de vista. Acá
       * queda la tarjeta chica (lo que hay y cómo sabe, de un vistazo) y el
       * detalle completo se abre en una hoja que sube desde abajo.
       *
       * Son dos acciones en dos lugares, como marca la lámina: tocar la
       * tarjeta abre la hoja, el botón va derecho a la tienda. No se pisan.
       */
      coffee && (
        <section class="tolva-mini zona-panel" aria-label="En tolva ahora">
          <div class="tolva-mini__cuerpo">
            <div class="tolva-mini__info">
              <span class="chip chip--fill chip--shadow">En tolva ahora</span>
              <span class="tolva-mini__valor">{placeLabel(coffee)}</span>
              <span class="tolva-mini__sub">Tostadero {coffee.roaster}</span>
              <button
                class="tolva-mini__abrir"
                type="button"
                data-hoja-abrir
                aria-haspopup="dialog"
              >
                Ver cómo es ›
              </button>
            </div>

            <div class="tolva-mini__penta">
              <Pentagono profile={coffee.profile} labels={false} />
            </div>
          </div>

          <a class="boton" href="#tienda">Llevate un cuarto</a>
        </section>
      )
    }
    </div>

    <div class="ticker" aria-hidden="true">
      <div class="ticker__banda">
        <div class="ticker__cinta" style={`--ticker-duracion:${tickerDuration}`}>
          <span>{tickerGroup}</span>
          <span>{tickerGroup}</span>
        </div>
      </div>
    </div>
  </div>

  <Tienda shelves={shelves} />

  {
    coffee && (
      <dialog class="hoja" id="hoja-tolva" aria-label="El café que hay en tolva">
        <div class="hoja__tirador" aria-hidden="true" />

        <div class="hoja__cabecera">
          <span class="chip chip--fill chip--shadow">En tolva ahora</span>
          {/* method="dialog" cierra sin una línea de JavaScript. */}
          <form method="dialog">
            <button class="hoja__x" type="submit" aria-label="Cerrar">
              ✕
            </button>
          </form>
        </div>

        <div class="hoja__grid">
          <div class="hoja__info">
            <Origen coffee={coffee} />
            <div class="hoja__tostadero">
              <span class="chip chip--fill">Tostadero</span>
              <p>{coffee.roaster}</p>
            </div>
          </div>

          <figure class="hoja__molino" aria-hidden="true">
            <img src="/molino-e65s.svg" alt="" width="240" height="560" />
            <figcaption>Mahlkönig E65S</figcaption>
          </figure>
        </div>

        <div class="hoja__sabor">
          <span class="chip chip--fill">A qué sabe</span>
          <Pentagono profile={coffee.profile} />
        </div>

        <a class="boton" href="#tienda">
          Llevate un cuarto
        </a>
      </dialog>
    )
  }

</Base>

<script>
  import { conectarDialogo } from "../scripts/dialogo";

  conectarDialogo(
    document.querySelector<HTMLDialogElement>("#hoja-tolva"),
    document.querySelector<HTMLElement>("[data-hoja-abrir]"),
  );
</script>

<style>
  /*
   * La home mide una pantalla y ni un píxel más: quien scrollea ya está
   * mirando la tienda, no más home.
   *
   * 100dvh y no 100vh: en el celular la barra del navegador aparece y se
   * esconde, y 100vh mide la ventana SIN ella, así que el contenido queda
   * cortado abajo mientras la barra está a la vista. dvh mide lo que de
   * verdad se ve en este momento.
   */
  .pantalla {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .home {
    flex: 1;
    position: relative;
    overflow: hidden;
    display: grid;
    align-content: center;
    /* El aire se mide contra el alto de la ventana, en escritorio también: un
       portátil de 900px y un monitor de 1440 no tienen el mismo margen para
       gastar, y el contenido tiene que entrar en los dos sin scrollear. Los
       topes son los valores de siempre, que es lo que vale en pantalla
       grande. */
    gap: clamp(var(--space-md), 3.5dvh, var(--space-xl));
    padding-block: clamp(var(--space-md), 2.7dvh, var(--space-xl));
    padding-inline: var(--space-lg);
  }

  /* La marca de agua del murciélago, muy tenue, arriba al centro: no compite
     con el contraste del texto porque va casi invisible y detrás de todo.
     Va en línea (no como fondo) para poder animarle los ojos; el resto del
     dibujo cuelga con un leve balanceo, como si colgara de una viga. */
  .marca-agua {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    width: 380px;
    height: auto;
    opacity: 0.05;
    pointer-events: none;
    z-index: -1;
    transform-origin: 50% 0;
    animation: hang 6.5s ease-in-out infinite;
  }

  .marca-agua__ojo {
    fill: var(--color-carbon);
    transform-box: fill-box;
    transform-origin: center;
    animation: blink 6s ease-in-out infinite;
  }

  .presentacion {
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }

  /* El héroe se mide contra SU columna, no contra la ventana: con `vw` crecía
     hasta desbordarse y meterse debajo del panel de la tolva. */
  .presentacion {
    container-type: inline-size;
  }

  .hero {
    margin: 0;
    font-family: var(--font-display);
    /* La lámina pesa 500: con 700 el título se empasta. */
    font-weight: 500;
    /* Dos límites, no uno: el ancho de su columna (cqw) y el alto de la
       ventana (dvh). Con el ancho solo, una ventana ancha y baja -un portátil
       de 1280 × 720- lo hacía enorme y empujaba la home fuera de la pantalla.
       Gana el que quede más chico. */
    font-size: clamp(40px, min(21cqw, 11dvh), 112px);
    line-height: 0.94;
    letter-spacing: -0.02em;
  }

  .hero span {
    display: block;
    animation: wipe 1.15s var(--ease-ambient) both;
  }

  .hero span:first-child {
    animation-delay: 0.3s;
  }

  .hero span:last-child {
    animation-delay: 0.45s;
  }

  .bajada {
    margin: 0;
    max-width: 46ch;
    font-size: var(--text-lead);
    color: var(--color-ceniza);
    animation: rise 1s var(--ease-ambient) 0.7s both;
  }

  /* Solo color, no un segundo peso: la auditoría tipográfica (tarea 6) pide
     dejar el menor número de combinaciones familia + tamaño + peso posible,
     y el contraste de color ya alcanza para destacar la palabra. */
  .bajada b {
    color: var(--color-hueso);
    font-weight: inherit;
  }

  /* El panel entero es de escritorio. Abajo de 1000px la tolva es la tarjeta
     chica más la hoja: el panel mide 699px y en una pantalla de celular se
     come todo lo demás. */
  .tolva {
    display: none;
    position: relative;
    overflow: hidden;
    /* Igual que la home: el aire cede contra el alto de la ventana, porque el
       panel es la columna más alta y es la que decide si todo entra. */
    gap: clamp(var(--space-md), 2.5dvh, var(--space-lg));
    justify-items: start;
    /* El fondo del panel no es plano, medido en la lámina. */
    background: linear-gradient(168deg, rgb(49, 51, 53), rgb(35, 36, 38));
    animation: rise 1s var(--ease-ambient) 0.55s both;
  }

  /* La luz del pozo de la tolva: una versión más chica y puntual del
     `.glow` de la home, por detrás y sin tapar el texto (z-index: -1).
     Tamaño y posición medidos en la lámina. */
  .tolva::before {
    content: "";
    position: absolute;
    width: 460px;
    height: 460px;
    top: -130px;
    right: -90px;
    pointer-events: none;
    z-index: -1;
    background: radial-gradient(
      closest-side,
      rgba(242, 196, 139, 0.22),
      rgba(242, 196, 139, 0) 72%
    );
    animation: breathe 7s ease-in-out infinite;
  }

  .tolva__grid {
    display: grid;
    gap: var(--space-lg);
    width: 100%;
  }

  .tolva__info {
    display: grid;
    gap: clamp(var(--space-md), 2.5dvh, var(--space-lg));
    justify-items: start;
  }

  .tolva__sabor,
  .tolva__tostadero {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
  }

  .tolva__tostadero p {
    margin: 0;
    font-size: var(--text-body);
  }

  /* El molino: vuelve como dibujo de línea (Tarea 6), en su propia columna
     a la derecha del contenido. Oculto por debajo de 1000px porque el
     panel ya es largo en el celular y el molino corre la información
     importante fuera de la primera pantalla. */
  .tolva__molino {
    display: none;
    margin: 0;
  }

  .tolva__pie {
    display: flex;
    /* La lámina no envuelve esta línea: la leyenda queda a la izquierda y
       el enlace a la derecha, en la misma fila. Con `wrap` el enlace no
       entraba en la fila y el `justify-content: space-between` de una
       fila con un solo elemento lo dejaba pegado a la izquierda, debajo
       de la leyenda. */
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    width: 100%;
    margin-top: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-sombra);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ceniza);
  }

  .tolva__pie a {
    margin-left: auto;
    flex-shrink: 0;
    font-size: var(--text-nano);
    color: var(--color-hueso);
    text-decoration: none;
    border-bottom: 1px solid var(--color-tostado);
    padding-bottom: 2px;
  }

  /*
   * La tarjeta chica del celular: lo que hay en tolva y cómo sabe, de un
   * vistazo, en el lugar de un panel de 699px.
   */
  .tolva-mini {
    display: grid;
    /* Contra el alto de la ventana, por lo mismo que el resto de la home:
       tiene que entrar en una pantalla y los teléfonos no miden todos igual. */
    gap: clamp(10px, 1.9dvh, 16px);
    justify-items: start;
    padding: clamp(10px, 1.9dvh, 16px);
    background: linear-gradient(168deg, var(--color-piedra), rgb(35, 36, 38));
    border: 1px solid rgba(232, 226, 208, 0.1);
    border-top: 1px solid rgba(136, 83, 51, 0.85);
    animation: rise 1s var(--ease-ambient) 0.55s both;
  }

  .tolva-mini__cuerpo {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 108px;
    gap: var(--space-sm);
    align-items: center;
    width: 100%;
  }

  .tolva-mini__info {
    display: grid;
    gap: clamp(5px, 0.95dvh, 8px);
    justify-items: start;
  }

  /* 19px en la lámina, no los 20 de --text-lead: el valor no puede competir
     con el héroe, que ahora está en 56. */
  .tolva-mini__valor {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 500;
    line-height: 1.15;
  }

  .tolva-mini__sub {
    font-size: var(--text-micro);
    color: var(--color-ceniza);
  }

  /* El botón se estira sobre toda la tarjeta con un ::after, en vez de envolver
     el pentágono: un <button> no puede contener una <figure>, y con el ::after
     toca toda el área pero un solo elemento recibe el foco. El botón de la
     tienda queda fuera de .tolva-mini__cuerpo, así que no se pisan. */
  .tolva-mini__abrir {
    font: inherit;
    border: 0;
    padding: 0;
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    /* 9px, medido en la lámina: es una pista de que la tarjeta se toca, no un
       botón que compita con "Llevate un cuarto". */
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brasa);
  }

  .tolva-mini__abrir::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .tolva-mini__penta {
    justify-self: end;
    width: 108px;
  }

  /*
   * La hoja con el detalle: sube desde abajo sobre la página. Va en un <dialog>
   * nativo abierto con showModal(), así que el fondo, la trampa de foco, el
   * Escape y la página inerte los pone el navegador.
   */
  .hoja {
    width: 100%;
    max-width: none;
    /* `margin: auto` es lo que centra un <dialog>: con 0 abajo queda pegado al
       borde inferior, que es de donde tiene que salir. */
    margin: auto 0 0;
    max-height: 88dvh;
    overflow-y: auto;
    gap: var(--space-lg);
    padding: var(--space-sm) var(--space-lg) var(--space-xl);
    border: 0;
    border-top: 2px solid var(--color-hueso);
    box-shadow: 0 -8px 0 var(--color-tostado);
    background: var(--color-carbon);
    color: var(--color-hueso);
  }

  .hoja::backdrop {
    background: rgba(12, 12, 13, 0.62);
  }

  /* El `display` va en [open] y no en la regla base: un <dialog> cerrado está
     oculto por la hoja de estilos del navegador con `display: none`, y
     declararle un display propio lo deja visible SIEMPRE, abierto o no. */
  .hoja[open] {
    display: grid;
    animation: sheetUp 0.55s var(--ease-persona) both;
  }

  .hoja__tirador {
    justify-self: center;
    width: 46px;
    height: 4px;
    background: rgba(232, 226, 208, 0.3);
  }

  .hoja__cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .hoja__x {
