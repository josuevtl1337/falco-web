---
import { env } from "cloudflare:workers";
import {
  getHopperCoffee,
  getSettings,
  getUpcomingSpecialDays,
  getWeekHours,
  instagramPostOf,
  listCoffeesByIds,
  listShelf,
} from "@falco/db";
import { getOpenStatus, toArgentina } from "@falco/domain";
import Base from "../layouts/Base.astro";
import { cafeJsonLd, jsonForScript } from "../seo";
import DondeEstamos from "../components/DondeEstamos.astro";
import { notasDe } from "../components/ficha-cafe";
import Nav from "../components/Nav.astro";
import Origen from "../components/Origen.astro";
import Pentagono from "../components/Pentagono.astro";
import Pie from "../components/Pie.astro";
import Tienda from "../components/Tienda.astro";
import Vitrina from "../components/Vitrina.astro";
import { OpenNow } from "../islands/OpenNow";

const now = new Date();
const week = await getWeekHours(env.DB);
const nowAR = toArgentina(now);
const specials = await getUpcomingSpecialDays(env.DB, nowAR.date, 30);
const status = getOpenStatus(now, week, specials);
const coffee = await getHopperCoffee(env.DB);
// Las notas de cata como etiquetas: tres en la tarjeta de la home, hasta
// cinco en la hoja de "Ver cómo es".
const tastingNotes = notasDe(coffee?.tastingNotes, 5);
const settings = await getSettings(env.DB);

// Los estantes son lo que sigue abajo de la primera pantalla: la home termina
// donde termina la ventana y scrollear ya es entrar en la tienda.
const [coffeeShelf, kitsShelf] = await Promise.all([
  listShelf(env.DB, "coffee"),
  listShelf(env.DB, "kits"),
]);
const shelves = [
  { title: "Café", products: coffeeShelf },
  { title: "Kits y accesorios", products: kitsShelf },
];

// El detalle de un producto de café muestra su perfil de cata, que vive en
// `coffees`. Se piden todos de una vez, no uno por ficha.
const coffees = new Map(
  (
    await listCoffeesByIds(
      env.DB,
      shelves
        .flatMap((shelf) => shelf.products)
        .map((product) => product.coffeeId)
        .filter((id): id is number => id !== undefined),
    )
  ).map((item) => [item.id, item]),
);

// La publicación de Instagram del costado, en la compu: la carga el admin.
const instagramPost = instagramPostOf(settings);

// "Guatemala · Huehuetenango": el país y la región del café en tolva.
const tolvaOrigen = coffee && [coffee.country, coffee.name].filter(Boolean).join(" · ");

const cafe = cafeJsonLd({
  site: Astro.site ?? Astro.url,
  week,
  specials,
  instagramUrl: settings.instagram_url,
});
---

<Base
  title="Falco · café de santoto"
  description="Café de especialidad en Santo Tomé. Mirá qué hay en la tolva y llevate un cuarto."
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={jsonForScript(cafe)}
  />
  <!--
    La barra queda arriba de la primera pantalla y sigue visible al scrollear
    (position: sticky, en Nav.astro). Como sticky ocupa su lugar en el flujo,
    la primera pantalla es la ventana menos el alto de la barra, que está
    declarado en el token --alto-nav y no medido a ojo.
  -->
  <Nav />

  <!--
    La primera pantalla. En el celular, quien llega viene casi siempre de
    Instagram: arriba lo que busca (si está abierto, la carta, la tienda y
    cómo llegar) y lo que hay en tolva. En la compu, al costado va la última
    publicación de Instagram, que lleva al post.
  -->
  <div class="pantalla">
    <div class:list={["home", "grainy", instagramPost && "home--con-post"]}>
      <div class="home__luz" aria-hidden="true"></div>

      <div class="home__principal">
        <div class="home__cabeza">
          <div class="home__estado">
            <OpenNow week={week} specials={specials} initial={status} client:idle />
            <p class="home__direccion">Iriondo 2153<br />Santo Tomé</p>
          </div>
          <div class="home__titulo">
            <h1 class="hero">café de santoto</h1>
            <p class="bajada">Hacemos el café que nos gusta tomar.</p>
          </div>
        </div>

        <!-- En la compu, dos botones. En el celular, la carta en grande y
             dos accesos: es a lo que viene la mayoría. -->
        <div class="home__botones">
          <a class="boton" href="/carta">Ver la carta</a>
          <a class="boton boton--linea" href="/#tienda">Llevate un cuarto</a>
        </div>

        <div class="home__accesos">
          <a class="acceso-carta" href="/carta">
            <span class="acceso-carta__texto">
              <span class="acceso__etiqueta">La carta</span>
              <span class="acceso-carta__titulo">Ver la carta</span>
              <span class="acceso-carta__bajada">Café, fríos, salados y dulces.</span>
            </span>
            <span class="acceso-carta__flecha" aria-hidden="true">→</span>
          </a>
          <div class="home__accesos-par">
            <a class="acceso" href="/#tienda">
              <span class="acceso__etiqueta">La tienda</span>
              <span class="acceso__titulo">Llevate un cuarto</span>
              <span class="acceso__bajada">Café en grano y kits ›</span>
            </a>
            <a class="acceso" href="/#donde-estamos">
              <span class="acceso__etiqueta">Dónde</span>
              <span class="acceso__titulo">Cómo llegar</span>
              <span class="acceso__bajada">Horarios y mapa ›</span>
            </a>
          </div>
        </div>

        {
          coffee && (
            <section class="tolva" aria-label="En tolva ahora">
              {coffee.imageKey && (
                <img
                  class="tolva__foto"
                  src={`/fotos/${coffee.imageKey}`}
                  alt=""
                  width="120"
                  height="88"
                  decoding="async"
                />
              )}
              <div class="tolva__info">
                <span class="tolva__sello">En tolva ahora</span>
                <span class="tolva__origen">{tolvaOrigen}</span>
                <span class="tolva__tostadero">Tostadero {coffee.roaster}</span>
                {tastingNotes.length > 0 && (
                  <span class="tolva__notas">{tastingNotes.slice(0, 3).join(" · ")}</span>
                )}
                <button
                  class="tolva__abrir"
                  type="button"
                  data-hoja-abrir
                  aria-haspopup="dialog"
                >
                  Ver cómo es ›
                </button>
              </div>
            </section>
          )
        }
      </div>

      {
        instagramPost ? (
          <a
            class="post"
            href={instagramPost.url}
            target="_blank"
            rel="noopener"
            aria-label="Ver la última publicación de @falco.cafe en Instagram"
          >
            <span class="post__cabeza">
              <span class="post__avatar" aria-hidden="true">
                <img src="/logo-falco.svg" alt="" width="28" height="11" />
              </span>
              <b>falco.cafe</b>
              <span class="post__ir" aria-hidden="true">Ir ↗</span>
            </span>
            <img
              class="post__foto"
              src={`/fotos/${instagramPost.imageKey}`}
              alt=""
              width="470"
              height="588"
              decoding="async"
            />
            {instagramPost.caption && (
              <span class="post__texto">
                <b>falco.cafe</b> {instagramPost.caption}
              </span>
            )}
          </a>
        ) : (
          coffee?.imageKey && (
            <div class="home__vitrina" aria-hidden="true">
              <Vitrina imageKey={coffee.imageKey} />
            </div>
          )
        )
      }
    </div>
  </div>

  <Tienda shelves={shelves} coffees={coffees} db={env.DB} />

  <!-- Dónde estamos y el pie ocupan juntos la última pantalla. -->
  <div class="final">
    <DondeEstamos
      week={week}
      specials={specials}
      status={status}
      nowAR={nowAR}
      instagramUrl={settings.instagram_url}
      roaster={coffee?.roaster}
    />
    <Pie
      instagramUrl={settings.instagram_url}
      whatsapp={settings.whatsapp_number}
    />
  </div>

  {
    coffee && (
      <dialog
        class="hoja"
        id="hoja-tolva"
        aria-label="El café que hay en tolva"
      >
        <div class="hoja__tirador" aria-hidden="true" />

        <div class="hoja__cabecera">
          <span class="chip chip--fill chip--shadow">En tolva ahora</span>
          {/* method="dialog" cierra sin una línea de JavaScript. */}
          <form method="dialog">
            <button class="hoja__x" type="submit" aria-label="Cerrar">
              ✕
            </button>
          </form>
        </div>

        <div class="hoja__grid">
          <div class="hoja__info">
            <Origen coffee={coffee} />
            <div class="hoja__tostadero">
              <span class="chip chip--fill">Tostadero</span>
              <p>{coffee.roaster}</p>
            </div>
          </div>

          {coffee.imageKey && (
            <div class="hoja__molino">
              <Vitrina imageKey={coffee.imageKey} size="chica" />
            </div>
          )}
        </div>

        <div class="hoja__sabor">
          <span class="chip chip--fill">A qué sabe</span>
          {tastingNotes.length > 0 && (
            <ul class="hoja__notas" aria-label="Notas de cata">
              {tastingNotes.map((nota) => (
                <li>{nota}</li>
              ))}
            </ul>
          )}
          <Pentagono profile={coffee.profile} />
        </div>

        <a class="boton" href="#tienda">
          Llevate un cuarto
        </a>
      </dialog>
    )
  }
</Base>

<script>
  import { conectarDialogo } from "../scripts/dialogo";

  conectarDialogo(
    document.querySelector<HTMLDialogElement>("#hoja-tolva"),
    document.querySelector<HTMLElement>("[data-hoja-abrir]"),
  );
</script>

<style>
  /*
   * La primera pantalla. Ritmo fijo: 20 de margen a los costados en el
   * celular, 12 entre piezas de un mismo grupo, 28 entre grupos.
   */
  .pantalla {
    min-height: calc(100dvh - var(--alto-nav));
    display: flex;
    flex-direction: column;
  }

  .home {
    --entre-grupos: 28px;
    flex: 1;
    position: relative;
    overflow: hidden;
    display: grid;
    align-content: start;
    gap: var(--entre-grupos);
    padding: 20px 20px 36px;
  }

  /* Un solo pozo de luz tibia, detrás del título. */
  .home__luz {
    position: absolute;
    inset: -10% 0 auto;
    height: 60%;
    background: radial-gradient(
      ellipse 70% 50% at 40% 30%,
      rgba(242, 196, 139, 0.12),
      rgba(242, 196, 139, 0)
    );
    pointer-events: none;
    z-index: -1;
  }

  .home__principal {
    display: grid;
    gap: var(--entre-grupos);
    align-content: start;
    min-width: 0;
  }

  .home__cabeza {
    display: grid;
    gap: 16px;
  }

  .home__estado {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  /* En el celular la dirección no entra al lado del cartel: la resuelve
     "Cómo llegar". En la compu va al lado. */
  .home__direccion {
    display: none;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.6;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: right;
    color: var(--color-ceniza);
  }

  .home__titulo {
    display: grid;
    gap: 10px;
  }

  .hero {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(48px, 15vw, 64px);
    line-height: 0.88;
    letter-spacing: -0.045em;
    animation: rise 0.9s var(--ease-ambient) 0.2s both;
  }

  .bajada {
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
    color: #c9c6bd;
  }

  /* Los botones de la compu: en el celular manda el bloque grande. */
  .home__botones {
    display: none;
    flex-wrap: wrap;
    gap: 22px;
  }

  .home__accesos {
    display: grid;
    gap: 12px;
  }

  .acceso__etiqueta {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-brasa);
  }

  /* "Ver la carta": el bloque tostado, lo primero que se toca. El margen de
     abajo es el de su sombra, así la fila que sigue no queda pegada. */
  .acceso-carta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
    padding: 20px;
    background: var(--color-tostado);
    box-shadow: 6px 6px 0 var(--color-hueso);
    color: var(--color-hueso);
    text-decoration: none;
  }

  .acceso-carta__texto {
    display: grid;
    gap: 8px;
  }

  .acceso-carta__titulo {
    font-family: var(--font-display);
    font-size: 38px;
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.035em;
  }

  .acceso-carta__bajada {
    font-size: 13px;
    line-height: 1.4;
    color: #f0e3cf;
  }

  .acceso-carta__flecha {
    font-family: var(--font-display);
    font-size: 34px;
    line-height: 1;
  }

  .home__accesos-par {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .acceso {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 16px;
    background: var(--color-sombra);
    border: 1px solid rgba(232, 226, 208, 0.16);
    color: var(--color-hueso);
    text-decoration: none;
  }

  .acceso__titulo {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 500;
    line-height: 1.1;
  }

  .acceso__bajada {
    font-size: 12px;
    color: var(--color-ceniza);
  }

  .acceso-carta:focus-visible,
  .acceso:focus-visible,
  .post:focus-visible {
    outline: 2px solid var(--color-brasa);
    outline-offset: 3px;
  }

  /* En tolva ahora: el paquete, de dónde es, quién lo tuesta y a qué sabe. */
  .tolva {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 16px;
    align-items: center;
    padding: 16px;
    background: var(--color-sombra);
    border: 1px solid rgba(232, 226, 208, 0.14);
    box-shadow: 6px 6px 0 var(--color-tostado);
  }

  .tolva__foto {
    display: block;
    width: 96px;
    height: auto;
    filter: drop-shadow(0 8px 10px rgba(0, 0, 0, 0.45));
  }

  .tolva__info {
    display: grid;
    justify-items: start;
    gap: 6px;
  }

  .tolva__sello {
    position: relative;
    isolation: isolate;
    padding: 4px 8px 3px;
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .tolva__sello::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-tostado);
    transform: skewX(-12deg);
  }

  .tolva__origen {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.15;
  }

  .tolva__tostadero,
  .tolva__notas {
    font-size: 12px;
    color: var(--color-ceniza);
  }

  /* El botón toca toda la tarjeta con su ::after: un solo foco. */
  .tolva__abrir {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-brasa);
  }

  .tolva__abrir::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  /* La publicación de Instagram y la vitrina de reemplazo: sólo en la compu. */
  .post,
  .home__vitrina {
    display: none;
  }

  /*
   * Compu: dos columnas. A la izquierda el título, los botones y la tolva; a
   * la derecha la publicación, inclinada con la sombra dura de la marca.
   */
  @media (min-width: 900px) {
    .home {
      --entre-grupos: 32px;
      grid-template-columns: minmax(0, 1fr) minmax(0, 470px);
      align-content: center;
      align-items: center;
      column-gap: clamp(48px, 6vw, 120px);
      padding: clamp(24px, 4dvh, 48px) var(--space-xxl) clamp(32px, 5dvh, 56px);
    }

    .home__estado {
      justify-content: flex-start;
      gap: 24px;
    }

    .home__direccion {
      text-align: left;
      white-space: nowrap;
    }

    .hero {
      font-size: clamp(64px, min(8.6vw, 13dvh), 124px);
    }

    .bajada {
      font-size: 19px;
    }

    .home__botones {
      display: flex;
    }

    .home__accesos {
      display: none;
    }

    .tolva {
      max-width: 560px;
      padding: 18px 22px;
      box-shadow: 9px 9px 0 var(--color-tostado);
    }

    .tolva__foto {
      width: 120px;
    }

    .tolva__origen {
      font-size: 21px;
    }

    .tolva__tostadero,
    .tolva__notas {
      font-size: 13px;
    }

    .post {
      display: grid;
      align-self: center;
      background: var(--color-sombra);
      border: 1px solid rgba(232, 226, 208, 0.16);
      box-shadow: 12px 12px 0 var(--color-tostado);
      transform: rotate(2deg);
      color: var(--color-hueso);
      text-decoration: none;
      transition: transform 0.38s var(--ease-persona);
    }

    .post:hover {
      transform: rotate(0deg) translateY(-4px);
    }

    .home__vitrina {
      display: grid;
      justify-items: center;
    }
  }

  /* Entre 900 y 1200 la publicación se angosta, para que la columna del
     título tenga lugar; la dirección aparece recién con ancho de sobra. */
  @media (min-width: 900px) and (max-width: 1199px) {
    .home {
      grid-template-columns: minmax(0, 1fr) minmax(0, 360px);
      column-gap: 56px;
      padding-inline: var(--space-xl);
    }
  }

  @media (min-width: 1200px) {
    .home__direccion {
      display: block;
    }
  }

  .post__cabeza {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    font-size: 14px;
  }

  .post__avatar {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--color-brasa);
    background: var(--color-carbon);
  }

  .post__ir {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-brasa);
  }

  /* 4:5, el formato de las publicaciones. En una ventana baja la foto cede
     alto para que la tarjeta entre entera. */
  .post__foto {
    display: block;
    width: 100%;
    height: auto;
    max-height: min(588px, 62dvh);
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .post__texto {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /* Margen y no relleno: el recorte de dos renglones deja ver lo que cae
       en el relleno, y se asomaba un tercero. */
    max-height: calc(2 * 1.45em);
    margin: 14px 16px 16px;
    font-size: 14px;
    line-height: 1.45;
    color: #c9c6bd;
  }

  .post__texto b {
    color: var(--color-hueso);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero,
    .post {
      animation: none;
      transition: none;
    }
  }

  .final {
    display: flex;
    flex-direction: column;
    min-height: calc(100dvh - var(--alto-nav));
  }

  /*
   * La hoja con el detalle: sube desde abajo sobre la página. Va en un <dialog>
   * nativo abierto con showModal(), así que el fondo, la trampa de foco, el
   * Escape y la página inerte los pone el navegador.
   */
  .hoja {
    width: 100%;
    max-width: none;
    /* `margin: auto` es lo que centra un <dialog>: con 0 abajo queda pegado al
       borde inferior, que es de donde tiene que salir. */
    margin: auto 0 0;
    max-height: 88dvh;
    overflow-y: auto;
    /* El pentágono y sus etiquetas no pueden abrir un scroll de costado. */
    overflow-x: hidden;
    gap: var(--space-lg);
    padding: var(--space-sm) var(--space-lg) var(--space-xl);
    border: 0;
    border-top: 2px solid var(--color-hueso);
    box-shadow: 0 -8px 0 var(--color-tostado);
    background: var(--color-carbon);
    color: var(--color-hueso);
  }

  .hoja::backdrop {
    background: rgba(12, 12, 13, 0.62);
  }

  /* El `display` va en [open] y no en la regla base: un <dialog> cerrado está
     oculto por la hoja de estilos del navegador con `display: none`, y
     declararle un display propio lo deja visible SIEMPRE, abierto o no. */
  .hoja[open] {
    display: grid;
    animation: sheetUp 0.55s var(--ease-persona) both;
  }

  .hoja__tirador {
    justify-self: center;
    width: 46px;
    height: 4px;
    background: rgba(232, 226, 208, 0.3);
  }

  .hoja__cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .hoja__x {
    width: var(--touch-min);
    height: var(--touch-min);
    display: grid;
    place-items: center;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: none;
    font-size: var(--text-body);
    color: var(--color-ceniza);
  }

  .hoja__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 104px;
    gap: var(--space-md);
    align-items: start;
  }

  .hoja__info,
  .hoja__sabor,
  .hoja__tostadero {
