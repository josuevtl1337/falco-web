---
import { env } from "cloudflare:workers";
import {
  getHopperCoffee,
  getUpcomingSpecialDays,
  getWeekHours,
} from "@falco/db";
import { getOpenStatus, toArgentina } from "@falco/domain";
import Base from "../layouts/Base.astro";
import Calendario from "../components/Calendario.astro";
import Dialogo from "../components/Dialogo.astro";
import { dayMoment } from "../components/fecha";
import Nav from "../components/Nav.astro";
import Origen from "../components/Origen.astro";
import Pentagono from "../components/Pentagono.astro";
import { OpenNow } from "../islands/OpenNow";

const now = new Date();
const week = await getWeekHours(env.DB);
const nowAR = toArgentina(now);
const specials = await getUpcomingSpecialDays(env.DB, nowAR.date, 30);
const status = getOpenStatus(now, week, specials);
const coffee = await getHopperCoffee(env.DB);

// nowAR.date siempre es "AAAA-MM-DD": partirlo evita una segunda pasada por
// Intl solo para el número de día y de mes.
const [, monthText, dayText] = nowAR.date.split("-");

const tickerText =
  [
    coffee && `En tolva ${coffee.country}`,
    coffee && `Tostadero ${coffee.roaster}`,
    "Iriondo 2153 · Santo Tomé",
  ]
    .filter((item): item is string => Boolean(item))
    .join(" ◆ ") + " ◆";
---

<Base
  title="Falco · café de santoto"
  description="Café de especialidad en Santo Tomé. Mirá qué hay en la tolva y llevate un cuarto."
>
  <Nav slot="nav" />

  <div class="home">
    <header class="hud zona-hud">
      <Calendario
        weekday={nowAR.weekday}
        day={Number(dayText)}
        month={Number(monthText)}
        moment={dayMoment(nowAR.minutes)}
      />
      <OpenNow week={week} specials={specials} initial={status} client:idle />
      <p class="direccion">Iriondo 2153 · Santo Tomé, Santa Fe</p>
    </header>

    <section class="presentacion zona-texto">
      <h1 class="hero"><span>café de</span><span>santoto</span></h1>
      <p class="bajada">
        Somos una cafetería de especialidad en una esquina de Santo Tomé.
        Tostamos con <b>Puerto Blest</b> y servimos café que se puede entender
        sin saber nada de café.
      </p>
      <Dialogo>
        <p>
          Nuestra misión siempre fue la misma: traer el mundo del café a
          Santo Tomé.
        </p>
      </Dialogo>
    </section>

    {
      coffee && (
        <section class="panel tolva zona-panel" aria-label="En tolva ahora">
          <span class="chip chip--fill">En tolva ahora</span>

          <Origen coffee={coffee} />

          <div class="tolva__sabor">
            <span class="chip chip--fill">A qué sabe</span>
            <Pentagono profile={coffee.profile} />
          </div>

          <div class="tolva__tostadero">
            <span class="chip chip--fill">Tostadero</span>
            <p>{coffee.roaster}</p>
          </div>

          <div class="tolva__pie">
            <span>Cambia cada vez que cambiamos el grano</span>
            <a href="/tienda">Llevate un cuarto →</a>
          </div>
        </section>
      )
    }
  </div>

  <div class="ticker" aria-hidden="true">
    <div class="ticker__banda">
      <div class="ticker__cinta">
        <span>{tickerText}</span>
        <span>{tickerText}</span>
      </div>
    </div>
  </div>
</Base>

<style>
  .home {
    position: relative;
    display: grid;
    gap: var(--space-xl);
    padding: var(--space-xl) var(--space-lg);
  }

  /* La cara del murciélago, muy tenue, arriba al centro: no compite con el
     contraste del texto porque va casi invisible y detrás de todo. */
  .home::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 480px;
    background-image: url("/falco-face.svg");
    background-repeat: no-repeat;
    background-position: top center;
    background-size: 380px auto;
    opacity: 0.05;
    pointer-events: none;
    z-index: -1;
  }

  .presentacion {
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }

  .hero {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: 0.94;
    letter-spacing: -0.02em;
  }

  .hero span {
    display: block;
  }

  .bajada {
    margin: 0;
    max-width: 46ch;
    font-size: var(--text-lead);
    color: var(--color-ceniza);
  }

  .bajada b {
    color: var(--color-hueso);
    font-weight: 600;
  }

  .tolva {
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }

  .tolva__sabor,
  .tolva__tostadero {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
  }

  .tolva__tostadero p {
    margin: 0;
    font-size: var(--text-body);
  }

  .tolva__pie {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    width: 100%;
    margin-top: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-sombra);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ceniza);
  }

  .tolva__pie a {
    color: var(--color-hueso);
    text-decoration: none;
    border-bottom: 1px solid var(--color-tostado);
    padding-bottom: 2px;
  }

  /* En escritorio la tolva va al costado, como en la lámina: el texto a la
     izquierda y el panel a la derecha, ocupando las dos filas. Apilado se
     pierde la composición y la tolva queda debajo del pliegue. */
  @media (min-width: 1000px) {
    .home {
      grid-template-columns: minmax(0, 1fr) minmax(360px, 460px);
      grid-template-areas:
        "hud panel"
        "texto panel";
      align-items: start;
      column-gap: var(--space-xxl);
      padding-inline: var(--space-xxl);
    }

    .zona-hud {
      grid-area: hud;
    }

    .zona-texto {
      grid-area: texto;
    }

    .zona-panel {
      grid-area: panel;
    }
  }

  @media (min-width: 900px) and (max-width: 999px) {
    .home {
      padding-inline: var(--space-xxl);
    }
  }

  @media (max-width: 640px) {
    .home {
      gap: var(--space-md);
      padding: var(--space-lg) var(--space-md);
    }

    .home::before {
      height: 320px;
      background-size: 260px auto;
    }

    .presentacion {
      gap: var(--space-sm);
    }

    .bajada {
      font-size: var(--text-body);
    }

    .panel.tolva {
      padding: var(--space-md);
      gap: var(--space-md);
    }
  }
</style>
