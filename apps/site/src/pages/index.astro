    height: var(--touch-min);
    display: grid;
    place-items: center;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: none;
    font-size: var(--text-body);
    color: var(--color-ceniza);
  }

  .hoja__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 104px;
    gap: var(--space-md);
    align-items: start;
  }

  .hoja__info,
  .hoja__sabor,
  .hoja__tostadero {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
    align-content: start;
  }

  .hoja__info {
    gap: var(--space-lg);
  }

  .hoja__tostadero p {
    margin: 0;
    font-size: var(--text-body);
  }

  .hoja__molino {
    display: grid;
    justify-items: center;
    gap: var(--space-sm);
    margin: 0;
  }

  .hoja__molino img {
    width: 100%;
    max-width: 104px;
    height: auto;
  }

  .hoja__molino figcaption {
    font-family: var(--font-mono);
    font-size: var(--text-nano);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-ceniza);
  }

  @media (prefers-reduced-motion: reduce) {
    .hoja[open],
    .tolva-mini {
      animation: none;
    }
  }

  @media (min-width: 1000px) {
    /* Desde acá manda el panel entero: la tarjeta chica y su hoja se van. */
    .tolva {
      display: grid;
    }

    .tolva-mini,
    .hoja[open] {
      display: none;
    }

    .home {
      /* Proporción, no ancho fijo: en la lámina el panel ocupa el 42 % de la
         fila. Con un máximo en píxeles, a 1024px se comía la columna del
         texto y el héroe quedaba diminuto. */
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      grid-template-areas:
        "hud panel"
        "texto panel";
      align-items: start;
      column-gap: var(--space-xxl);
      padding-inline: var(--space-xxl);
    }

    .zona-hud {
      grid-area: hud;
    }

    .zona-texto {
      grid-area: texto;
    }

    .zona-panel {
      grid-area: panel;
    }

    .tolva__grid {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
    }

  }

  /* El molino recién entra cuando el panel tiene ancho de sobra: por debajo
     le roba lugar al café, que es lo que la gente viene a leer. */
  @media (min-width: 1240px) {
    .tolva__molino {
      display: grid;
      justify-items: center;
      gap: var(--space-sm);
    }

    .tolva__molino img {
      /* En la lámina el molino ocupa cerca del 37 % del ancho de la tarjeta.
         A 100px leía como un ícono, no como una ilustración. */
      width: 150px;
      height: auto;
    }

    .tolva__molino figcaption {
      font-family: var(--font-mono);
      font-size: var(--text-nano);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      text-align: center;
      color: var(--color-ceniza);
    }
  }

  @media (min-width: 900px) and (max-width: 999px) {
    .home {
      padding-inline: var(--space-xxl);
    }
  }

  /* Donde manda la tarjeta chica -todo lo que no es escritorio- la cinta no
     entra en la primera pantalla, y la lámina tampoco la tiene ahí: lo que
     dice (el café, el tostadero, la dirección) ya está arriba, en la tarjeta
     y en el encabezado. */
  @media (max-width: 999px) {
    .ticker {
      display: none;
    }

    .presentacion {
      gap: clamp(8px, 1.6dvh, 24px);
    }

    .hero {
      font-size: min(21cqw, 8dvh);
    }

    .bajada {
      font-size: clamp(14px, 2dvh, 18px);
    }
  }

  /*
   * Ancho de sobra pero poco alto -un portátil de 1280 × 720-: el panel entero
   * mide 674px y ahí no entra. Vuelve la tarjeta chica, en la misma columna
   * del panel, y el detalle se abre en la hoja. Es el mismo recurso que en el
   * celular, por el mismo motivo: no hay alto.
   */
  /* Ventana baja pero no celular: el ritmo vertical se aprieta un escalón. La
     condición se escribe con el mínimo de 641px en vez de confiar en el orden
     de los bloques: si no, este bloque pisaría los valores más chicos del
     celular en un teléfono de 740px de alto y lo agrandaría. */
  @media (min-width: 641px) and (max-height: 820px) {
    .hero {
      font-size: min(21cqw, 10dvh);
    }

    .bajada {
      font-size: clamp(14px, 2.1dvh, 18px);
    }
  }

  @media (min-width: 1000px) and (max-height: 820px) {
    .tolva {
      display: none;
    }

    .tolva-mini {
      display: grid;
    }

    .hoja[open] {
      display: grid;
    }
  }

  @media (max-width: 640px) {
    /*
     * Todo lo que sigue sale de medir la lámina (persona/wireframes.html,
     * marco "Celular · 390") leyendo sus estilos calculados, no de estimar:
     * el tope de cada clamp es el valor exacto de la lámina a 390 × 844, y el
     * factor en dvh está elegido para dar ESE número a ese alto y achicarse
     * solo en un teléfono más corto.
     *
     * La lámina: gap 22px, padding 26px 22px.
     */
    .home {
      gap: clamp(12px, 2.6dvh, 22px);
      padding: clamp(14px, 3.1dvh, 26px) 22px;
    }

    .marca-agua {
      width: 260px;
    }

    /*
     * El orden de la lámina es HUD → héroe → tarjeta de la tolva → bajada →
     * cita: la tarjeta va metida entre el héroe y la bajada. Para lograrlo,
     * .presentacion deja de ser una caja y sus tres hijos pasan a ser celdas
     * del mismo grid que el HUD y la tarjeta, ordenados con `order`.
     *
     * Al dejar de tener caja deja de ser contenedor de consultas, así que acá
     * el héroe se mide contra la ventana (vw) y no contra su columna (cqw).
     */
    .presentacion {
      display: contents;
      container-type: normal;
    }

    /*
     * El contenido arranca pegado a la barra, no centrado.
     *
     * Con `align-content: center` el sobrante de la pantalla se repartía mitad
     * arriba y mitad abajo: en un 390 × 844 eran 61px de más entre la barra y
     * la fecha, justo en lo primero que se ve. En la lámina el HUD empieza a
     * 26px de la barra, que es exactamente el padding de la caja.
     */
    .home {
      align-content: start;
    }

    .zona-hud {
      order: 1;
    }

    .hero {
      order: 2;
      /* Lámina: 56px, interlineado 0,92 y -2,52px de tracking (-0,045em). */
      font-size: min(14.4vw, 6.6dvh);
      line-height: 0.92;
      letter-spacing: -0.045em;
    }

    .tolva-mini {
      order: 3;
    }

    /*
     * La bajada no va en el celular, en ningún tamaño.
     *
     * Decisión del dueño, dos veces: en una sola pantalla esa frase repite lo
     * que ya dicen el héroe ("café de santoto") y la cita de abajo ("traer el
     * mundo del café a Santo Tomé"). La lámina sí la tiene, pero acá manda lo
     * que él pidió, no la lámina.
     */
    .bajada {
      display: none;
    }

    .zona-cita {
      order: 5;
    }

    .panel.tolva {
      padding: var(--space-md);
      gap: var(--space-md);
    }

    /* Mismo aire reducido que el resto del panel: sin esto, el grid y la
       columna de info quedarían con el gap de escritorio (lg) aunque el
       panel ya haya bajado a md. */
    .tolva__grid,
    .tolva__info {
      gap: var(--space-md);
    }
  }
