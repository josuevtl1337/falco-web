---
import type { ProductWithOptions } from "@falco/db";
import { priceParts } from "./precio";

interface Props {
  product: ProductWithOptions;
}

const { product } = Astro.props;
---

<article class="ficha">
  <a href={`/tienda/${product.slug}`}>
    {product.isNew && <span class="chip chip--lit">Nuevo</span>}
    <h3>{product.name}</h3>
    <p class="ficha__detalle">{product.detail}</p>
    <p class="precio">
      {priceParts(product).map((parte) => <span>{parte}</span>)}
    </p>
  </a>
</article>

<style>
  .ficha a {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-md);
    min-height: var(--touch-min);
    background: var(--color-piedra);
    border-radius: var(--radius-md);
    text-decoration: none;
  }
  .ficha .chip {
    justify-self: start;
  }
  .ficha__detalle {
    color: var(--color-ceniza);
    margin: 0;
  }
</style>
