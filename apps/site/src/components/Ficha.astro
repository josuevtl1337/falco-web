---
import type { Coffee, ProductWithOptions } from "@falco/db";
import { formatArs } from "@falco/domain";
import { NEW_BADGE_STAR } from "./estrella";
import { nombreSinPais, notasDe, origenDe, puntajeSca } from "./ficha-cafe";

interface Props {
  product: ProductWithOptions;
  /** El nombre del estante: en la lámina encabeza la ficha, en brasa. */
  shelfLabel: string;
  /**
   * La ficha es de la copia del riel en movimiento: se puede tocar (la mitad
   * de lo que se ve en pantalla es la copia), pero el tabulador la saltea.
   */
  copy?: boolean;
  /**
   * El café del producto, si es un café. Con él la ficha es la "de papel":
   * la foto del paquete sobre fondo claro con el tostadero y el puntaje, el
   * origen arriba del nombre y las notas como etiquetas.
   */
  coffee?: Coffee;
}

const { product, shelfLabel, copy = false, coffee } = Astro.props;

const origen = coffee && origenDe(coffee, product.name);
const nombre = coffee ? nombreSinPais(product.name, coffee.country) : product.name;
const notas = notasDe(coffee?.tastingNotes);
---

<article class:list={["ficha", coffee && "ficha--cafe"]}>
  <a
    class="ficha__cara"
    href={`/tienda/${product.slug}`}
    tabindex={copy ? -1 : undefined}
  >
    {
      product.isNew && !coffee && (
        <span
          class="ficha__nuevo"
          style={`clip-path: polygon(${NEW_BADGE_STAR})`}
        >
          Nuevo
        </span>
      )
    }

    <!-- El hueco de la foto. Sin foto, en la lámina este espacio es un
         degradado con una luz arriba, que se lee como algo puesto a propósito
         y no como una imagen rota. Con foto, la foto lo tapa. -->
    <span class="ficha__foto">
      {
        product.imageKey && (
          <img src={`/fotos/${product.imageKey}`} alt="" loading="lazy" decoding="async" />
        )
      }
      {
        coffee && (
          <>
            <span class="ficha__tostadero">
              <span class="sr-only">Tostadero </span>
              {coffee.roaster}
            </span>
            {coffee.scaScore !== undefined && (
              <span class="ficha__sca">
                <b>{puntajeSca(coffee.scaScore)}</b> <span>SCA</span>
                <span class="sr-only"> puntos</span>
              </span>
            )}
            {product.isNew && <span class="ficha__placa-nuevo">Nuevo</span>}
          </>
        )
      }
    </span>

    <span class="ficha__cuerpo">
      <span class="ficha__codigo">{origen ?? shelfLabel}</span>
      <span class="ficha__nombre">{nombre}</span>
      <span class="ficha__detalle">{product.detail}</span>
      {
        notas.length > 0 && (
          <span class="ficha__notas">
            {notas.map((nota) => (
              <span>{nota}</span>
            ))}
          </span>
        )
      }

      <span class="ficha__pie">
        <span><b>{formatArs(product.priceCashArs)}</b> efectivo</span>
        <span class="ficha__pedir">Pedir ›</span>
      </span>

      <!-- Los dos precios van los dos en la ficha: Falco cobra distinto según
           cómo se pague y esconder uno de los dos hasta el detalle haría que
           el precio de la ficha fuera mentira para quien paga con tarjeta. -->
      <span class="ficha__tarjeta">
        {formatArs(product.priceCardArs)} tarjeta{
          product.askStock && " · consultar stock"
        }
      </span>
    </span>
  </a>
</article>

<style>
  .ficha {
    position: relative;
    /* El ancho de la lámina. Fijo a propósito: las fichas viven en un riel
       horizontal, no en una grilla que las estire. */
    width: 250px;
    flex: none;
    /* La cara se estira al alto de la ficha, que en el riel es el de la más
       alta de la fila: todas miden lo mismo. */
    display: grid;
  }

  .ficha__cara {
    display: grid;
    grid-template-rows: auto 1fr;
    text-decoration: none;
    color: var(--color-hueso);
    background: linear-gradient(168deg, var(--color-piedra), rgb(35, 36, 38));
    border: 1px solid rgba(232, 226, 208, 0.12);
  }

  .ficha__foto {
    display: block;
    position: relative;
    overflow: hidden;
    height: 150px;
    background: linear-gradient(150deg, #3b2519, rgb(35, 36, 38));
    border-bottom: 1px solid rgba(232, 226, 208, 0.1);
  }

  .ficha__foto img {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* La luz que entra desde arriba, como en el resto del sitio. */
  .ficha__foto::before {
    content: "";
    position: absolute;
    left: 50%;
    top: -60px;
    width: 220px;
    height: 220px;
    transform: translateX(-50%);
    background: radial-gradient(
      closest-side,
      rgba(242, 196, 139, 0.26),
      rgba(242, 196, 139, 0) 72%
    );
  }

  /* El pie se come el alto que sobra (margin-top: auto): así el precio queda
     abajo en todas las fichas, tenga el nombre uno o dos renglones. */
  .ficha__cuerpo {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px 14px;
  }

  .ficha__codigo {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-brasa);
  }

  .ficha__nombre {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-lead);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  /* El aire mínimo antes del pie va como margen del último renglón: el del
     pie es `auto` y se estira. */
  .ficha__detalle,
  .ficha__notas {
    margin-bottom: var(--space-sm);
  }

  .ficha__detalle:has(+ .ficha__notas) {
    margin-bottom: 4px;
  }

  .ficha__detalle {
    font-size: 13px;
    color: var(--color-ceniza);
  }

  /* El precio entero o nada: "$ 33.000" cortado de "efectivo" en la línea de
     abajo deja de leerse como un precio, y en una ficha de 206px se corta. Si
     no entra con el "Pedir", es el "Pedir" el que baja de renglón. */
  .ficha__pie {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 2px var(--space-sm);
    margin-top: auto;
    padding-top: 11px;
    border-top: 1px solid rgba(232, 226, 208, 0.09);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .ficha__pie > :first-child {
    white-space: nowrap;
  }

  .ficha__pie b {
    font-weight: 400;
  }

  .ficha__pedir {
    /* Pegado a la derecha aunque haya bajado solo a su propio renglón. */
    margin-left: auto;
    flex-shrink: 0;
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ceniza);
  }

  .ficha__tarjeta {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    color: var(--color-ceniza);
  }

  /* El sello de "Nuevo": una estrella de hueso de doce puntas, inclinada, que
     se balancea. La forma la recorta el clip-path que arma estrella.ts. Sale
     de la caja por arriba y a la derecha, por eso el riel le deja aire
     arriba. Un poco más grande que la caja de la lámina porque el recorte se
     come las esquinas: la palabra tiene que seguir entrando. */
  .ficha__nuevo {
    position: absolute;
    right: -18px;
    top: -24px;
    z-index: 5;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    background: var(--color-hueso);
    color: var(--color-carbon);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 13px;
    text-transform: uppercase;
    transform: rotate(12deg);
    animation: wobble 2.4s ease-in-out infinite;
  }

  /*
   * La ficha de un café: el paquete sobre papel, como una foto de estudio.
   * Las fotos se suben ya con ese fondo (1200 × 1000, la proporción de este
   * hueco); el degradé de acá es el mismo, así una foto que todavía no lo
   * tiene, o que tarda en cargar, no deja un hueco oscuro.
   */
  .ficha--cafe .ficha__foto {
    height: 210px;
    background: radial-gradient(
      closest-side at 50% 42%,
      #f4efe2,
      #ebe4d1 70%,
      #ddd4bd
    );
    border-bottom: 0;
  }

  .ficha--cafe .ficha__foto::before {
    content: none;
  }

  .ficha__tostadero,
  .ficha__sca,
  .ficha__placa-nuevo {
    position: absolute;
    z-index: 2;
  }

  .ficha__tostadero {
    left: 12px;
    bottom: 10px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-carbon);
  }

  .ficha__sca {
    right: 12px;
    bottom: 10px;
    display: flex;
    align-items: baseline;
    gap: 5px;
    padding: 5px 8px 4px;
    background: var(--color-carbon);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.16em;
    color: var(--color-hueso);
  }

  .ficha__sca b {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    color: var(--color-brasa);
  }

  /* "Nuevo" en la ficha de papel: una placa tostada dentro de la foto. La
     estrella de hueso se perdía contra el fondo claro. */
  .ficha__placa-nuevo {
    right: 14px;
    top: 14px;
    padding: 5px 10px 4px;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-hueso);
    isolation: isolate;
  }

  .ficha__placa-nuevo::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-tostado);
    box-shadow: 3px 3px 0 var(--color-carbon);
    transform: skewX(-12deg);
  }

  /* Para el lector de pantalla: "Tostadero Berkel", "86 SCA puntos". */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .ficha__notas {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .ficha__notas span {
    padding: 4px 8px;
    background: var(--color-sombra);
    font-size: 12px;
    color: var(--color-hueso);
  }

  .ficha__cara:focus-visible {
    outline: 2px solid var(--color-brasa);
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    .ficha {
      width: 206px;
    }

    .ficha__foto {
      height: 112px;
    }

    .ficha--cafe .ficha__foto {
      height: 172px;
    }

    .ficha__notas span {
      font-size: 11px;
    }

    .ficha__nombre {
      font-size: 17px;
    }

    .ficha__detalle {
      font-size: 11.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ficha__nuevo {
      animation: none;
    }
  }
</style>
