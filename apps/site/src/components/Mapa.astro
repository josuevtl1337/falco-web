<style>
  .mapa {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--color-sombra);
    border: 1px solid rgba(232, 226, 208, 0.12);
    /* El tamaño lo decide quien lo usa: el mapa llena su caja. */
    height: 100%;
  }

  .mapa__plano {
    display: block;
    width: 100%;
    height: 100%;
  }


  .mapa :global(.ping) {
    transform-box: fill-box;
    transform-origin: center;
    animation: sonar 3.6s ease-out infinite;
  }

  .mapa :global(.ruta) {
    animation: andar 1.4s linear infinite;
  }

  @keyframes sonar {
    from {
      transform: scale(0.1);
      opacity: 1;
    }
    to {
      transform: scale(1);
      opacity: 0;
    }
  }

  @keyframes andar {
    to {
      stroke-dashoffset: -20;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mapa :global(.ping),
    .mapa :global(.ruta) {
      animation: none;
    }

    .mapa :global(.ping) {
      opacity: 0.4;
    }
  }
</style>
