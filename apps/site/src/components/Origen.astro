---
import type { Coffee } from "@falco/db";

interface Props {
  coffee: Coffee;
}

const { coffee } = Astro.props;

// Primera línea: de dónde sale el café. Segunda línea, más chica: cómo es.
// Cada dato es opcional según lo que el café tenga cargado.
// El nombre del café es la región ("Huila") y va junto al país, como en la
// lámina: [Finca La Esperanza] · [Huila, Colombia]. Sin él, la tolva no dice
// qué café hay, que es lo único que la gente viene a mirar.
const lugar = [coffee.name, coffee.country].filter(Boolean).join(", ");
const principal = [coffee.farm, lugar].filter(Boolean).join(" · ");
const secundaria = [
  coffee.variety,
  coffee.process,
  coffee.altitudeMasl ? `${coffee.altitudeMasl} msnm` : undefined,
]
  .filter(Boolean)
  .join(" · ");
---

<div class="origen">
  <span class="chip chip--fill">Origen</span>
  <p class="origen__principal">{principal}</p>
  {secundaria && <p class="origen__secundaria">{secundaria}</p>}
</div>

<style>
  .origen {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
  }

  .origen__principal {
    margin: var(--space-xs) 0 0;
    font-size: var(--text-body);
  }

  /* Mismo tamaño que la línea principal: el color ya la distingue como
     secundaria, sin sumar otra combinación de tamaño a la auditoría de la
     tarea 6. */
  .origen__secundaria {
    margin: 0;
    font-size: var(--text-body);
    color: var(--color-ceniza);
  }
</style>
