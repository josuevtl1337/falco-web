{
  "name": "@falco/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "typecheck": "wrangler types && astro check",
    "test": "vitest run",
    "db:reset": "node -e \"require('node:fs').rmSync('.wrangler/state/v3/d1',{recursive:true,force:true})\" && wrangler d1 migrations apply falco --local && wrangler d1 execute falco --local --file ../../packages/db/seed/seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.2",
    "@astrojs/react": "^6.0.6",
    "@falco/db": "*",
    "@falco/domain": "*",
    "@falco/ui": "*",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "astro": "^7.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "wrangler": "^4.135.0"
  }
}
