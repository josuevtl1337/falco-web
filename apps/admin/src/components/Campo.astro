---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"input">, "value"> {
  etiqueta: string;
  name: string;
  value?: string | number | null;
  /** El mensaje de validación de este campo, si lo hay. */
  error?: string;
  /** Una línea de ayuda debajo, en gris. */
  ayuda?: string;
  /** Un texto largo: se dibuja como <textarea>. */
  largo?: boolean;
}

const { etiqueta, name, value, error, ayuda, largo = false, ...resto } = Astro.props;
const id = `campo-${name}`;
const describe = [error && `${id}-error`, ayuda && `${id}-ayuda`].filter(Boolean).join(" ") || undefined;
---

<div class="campo">
  <label for={id}>{etiqueta}</label>
  {
    largo ? (
      <textarea
        class="input"
        id={id}
        name={name}
        aria-invalid={error ? "true" : undefined}
        aria-describedby={describe}
      >{value ?? ""}</textarea>
    ) : (
      <input
        class="input"
        id={id}
        name={name}
        value={value ?? ""}
        aria-invalid={error ? "true" : undefined}
        aria-describedby={describe}
        {...resto}
      />
    )
  }
  {error && <span class="error" id={`${id}-error`}>{error}</span>}
  {ayuda && <span class="nota" id={`${id}-ayuda`}>{ayuda}</span>}
</div>
